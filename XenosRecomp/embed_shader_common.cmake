# Writes a C++ source file that defines xenos_recomp::kShaderCommonText and
# kShaderCommonTextSize, the bytes of a file, so the library carries the HLSL
# header it has to paste into every shader.
#
#   cmake -DINPUT=<file> -DOUTPUT=<generated .cpp> -P embed_shader_common.cmake

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hexLength)

set(bytes "")
set(position 0)
while (position LESS hexLength)
    # 16 bytes a line; the last line takes what is left.
    string(SUBSTRING "${hex}" ${position} 32 line)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," line "${line}")
    string(APPEND bytes "    ${line}\n")
    math(EXPR position "${position} + 32")
endwhile()

file(WRITE "${OUTPUT}"
"// Generated by embed_shader_common.cmake from shader_common.h. Do not edit.
#include \"xenos_recomp.h\"

namespace xenos_recomp
{

const uint8_t kShaderCommonText[] =
{
${bytes}};

const size_t kShaderCommonTextSize = sizeof(kShaderCommonText);

}
")
